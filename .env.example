# ══════════════════════════════════════════════════════════════════
#  PinDrop Pro — SECRETS (copy this file to .env and fill it in)
#  NEVER commit .env to git!
# ══════════════════════════════════════════════════════════════════

# ── Pinterest (required for posting) ──────────────────────────────
# Create an app at https://developers.pinterest.com/apps/
# Scopes needed: boards:read boards:write pins:read pins:write user_accounts:read
# Redirect URI in the app settings: http://localhost:8888/callback
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# Quick test path: the app page has "Generate access tokens" (Trial env). Paste
# that token here to run the pipeline BEFORE the app is approved — the app secret
# is locked while review is pending, so OAuth cannot finish yet. Trial tokens
# expire (regenerate, or finish OAuth). OAuth is the permanent path:
#   PINTEREST_REFRESH_TOKEN gets written to data/pinterest_token.json by
#   `python -m bot auth --code <CODE>`
# PINTEREST_ACCESS_TOKEN=

# ── Affiliate IDs ─────────────────────────────────────────────────
# Amazon Associates tracking tag (from affiliate-program.amazon.in)
AMAZON_TAG=

# (Optional — can also live in config.yaml)
# Paste your af_invite link(s) from affiliate.meesho.com "Get commission link".
# Each platform you generate gets its OWN source token + campaign id — paste
# them ALL, comma-separated; the bot publishes the platform-correct one
# (IG → instagram_stories, FB → facebook, ...) so your Meesho report is clean.
# MEESHO_TEMPLATE_LINK=https://www.meesho.com/af_invite/PUB:instagram_stories:CAMP1?p_id=1,https://www.meesho.com/af_invite/PUB:facebook:CAMP2?p_id=2
# MEESHO_AFFID=
# FLIPKART_AFFID=
# ⭐ EarnKaro API token — BEST path: converts ANY product URL into YOUR
#    own ekaro.in profit link (Flipkart/Myntra/Ajio/Nykaa/Croma…), so
#    commission lands in your own EarnKaro account (no middleman).
#    Get it in 1 minute:  python -m bot earnkaro capture
#    Then verify live:    python -m bot earnkaro probe
# EARNKARO_API_TOKEN=eyJhbGciOi…
# Legacy static prefix (optional; only needed without the API token):
# EARNKARO_PREFIX=https://ekaro.in/enkr20240101s123456
# CUELINKS_TEMPLATE=https://your-cuelinks-goto?url={url}

# ── Instagram (optional — cross-post every product to your IG page) ────
# Long-lived Meta token with instagram_content_publish permission
# INSTAGRAM_ACCESS_TOKEN=
# IG_USER_ID=
# Free ImgBB key (api.imgbb.com) to host your designed pins publicly:
# IMGBB_KEY=

# ── YouTube Shorts (optional — reels become Shorts with your link) ────
# console.cloud.google.com → enable "YouTube Data API v3" → OAuth client
# (type: Desktop app) → YT_CLIENT_ID/SECRET below, then:
#   python -m bot yt-auth-url      # open URL, click Allow, copy code
#   python -m bot yt-auth --code <CODE>
# YT_CLIENT_ID=
# YT_CLIENT_SECRET=

# ── Telegram — alerts + optional public DEALS channel ────────────────
# Every posted deal can also broadcast to your Telegram deals channel:
# TELEGRAM_DEALS_CHANNEL=@your_deals_channel

# ── Telegram alerts (optional — phone lo notifications) ──────────────
# @BotFather → create bot → token; chat id via /getUpdates
# ── Facebook Page posting (optional; official Graph API) ────────────────
# Create a FB Page → Meta app → token with pages_manage_posts
# FACEBOOK_ACCESS_TOKEN=
# FACEBOOK_PAGE_ID=


# ── Dashboard panel lock ─────────────────────────────────────────────
# The admin panel (stats, queue, logs, posting controls) is password-locked
# so nobody on your VPS network can trigger posts or delete products.
# Leave this empty and the bot auto-creates a strong password on first run
# (see it with:  python -m bot dashboard-pass).
# Your PUBLIC money pages — /go/…, /deals/today, /subscribe/… — never need login.
# DASHBOARD_PASSWORD=
