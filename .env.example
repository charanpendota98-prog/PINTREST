# ══════════════════════════════════════════════════════════════════
#  PinDrop Pro — SECRETS (copy this file to .env and fill it in)
#  NEVER commit .env to git!
# ══════════════════════════════════════════════════════════════════

# ── Pinterest (required for posting) ──────────────────────────────
# Create an app at https://developers.pinterest.com/apps/
# Scopes needed: boards:read boards:write pins:read pins:write user_accounts:read
# Redirect URI in the app settings: http://localhost:8888/callback
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# ── Affiliate IDs ─────────────────────────────────────────────────
# Amazon Associates tracking tag (from affiliate-program.amazon.in)
AMAZON_TAG=

# (Optional — can also live in config.yaml)
# Paste ONE af_invite link from affiliate.meesho.com — bot learns your IDs
# and auto-generates af_invite links for every product (direct commission):
# MEESHO_TEMPLATE_LINK=https://www.meesho.com/af_invite/XXXX:instagram_stories:YYYY?p_id=...
# MEESHO_AFFID=
# FLIPKART_AFFID=
# EARNKARO_PREFIX=https://ekaro.in/enkr20240101s123456
# CUELINKS_TEMPLATE=https://your-cuelinks-goto?url={url}

# ── Instagram (optional — cross-post every product to your IG page) ────
# Long-lived Meta token with instagram_content_publish permission
# INSTAGRAM_ACCESS_TOKEN=
# IG_USER_ID=
# Free ImgBB key (api.imgbb.com) to host your designed pins publicly:
# IMGBB_KEY=

# ── Telegram alerts (optional — phone lo notifications) ──────────────
# @BotFather → create bot → token; chat id via /getUpdates
# ── Facebook Page posting (optional; official Graph API) ────────────────
# Create a FB Page → Meta app → token with pages_manage_posts
# FACEBOOK_ACCESS_TOKEN=
# FACEBOOK_PAGE_ID=

# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_DEALS_CHANNEL=@yourdealschannel   # broadcast every deal to a public channel
